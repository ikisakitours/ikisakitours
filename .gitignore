# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# custom scripts
scripts/sync-langs.mjs
scripts/convert.mjs
scripts/auto-translate.mjs
scripts/fix-untranslated.mjs
scripts/verify-translations.mjs
scripts/cleanup-extra-keys.mjs
scripts/fix-variables.mjs
